#!/usr/bin/env bash

set -u

read -r -p "Search text: " query
[[ -n "$query" ]] || exit 0

result="$(
    rg \
        --vimgrep \
        --smart-case \
        --hidden \
        --glob '!.git' \
        -- "$query" . 2>/dev/null |
    fzf \
        --delimiter ':' \
        --prompt='rg> ' \
        --preview 'bat --color=always --style=numbers --highlight-line {2} -- {1}' \
        --preview-window='right,60%,border-left'
)" || exit 0

file="${result%%:*}"
rest="${result#*:}"

line="${rest%%:*}"
rest="${rest#*:}"

column="${rest%%:*}"

exec /usr/bin/helix "$file:$line:$column"
