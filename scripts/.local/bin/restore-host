#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")/../../.." && pwd)"
CURRENT_HOST="$(</etc/hostname)"

APPLY=false
TARGET_HOST="$CURRENT_HOST"

usage() {
    cat <<'EOF'
Kullanım:
  restore-host
  restore-host --apply
  restore-host --host HOST
  restore-host --host HOST --apply

Varsayılan olarak yalnızca dry-run yapar.
--apply verilmeden hiçbir sistem dosyası değiştirilmez.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --apply)
            APPLY=true
            shift
            ;;
        --host)
            [[ $# -ge 2 ]] || {
                echo "HATA: --host için bir değer gerekli."
                exit 1
            }
            TARGET_HOST="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "HATA: Bilinmeyen seçenek: $1"
            usage
            exit 1
            ;;
    esac
done

HOST_DIR="$DOTFILES_DIR/hosts/$TARGET_HOST"

if [[ ! -d "$HOST_DIR" ]]; then
    echo "HATA: Host yapılandırması bulunamadı:"
    echo "  $HOST_DIR"
    exit 1
fi

if [[ "$TARGET_HOST" != "$CURRENT_HOST" ]]; then
    echo "HATA: Hedef host mevcut makineyle eşleşmiyor."
    echo "  Mevcut: $CURRENT_HOST"
    echo "  Hedef:   $TARGET_HOST"
    echo
    echo "Yanlış makineye sistem yapılandırması uygulanmasını önlemek için durduruldu."
    exit 1
fi

declare -a SAFE_FILES=(
    "etc/greetd/config.toml"
    "etc/nftables.conf"
    "etc/vconsole.conf"
    "etc/vtrgb"
    "etc/xdg/reflector/reflector.conf"
    "etc/systemd/sleep.conf.d/mem-deep.conf"
    "etc/systemd/system/nord-vt-colors.service"
)

declare -a CRITICAL_FILES=(
    "etc/fstab"
    "boot/loader/entries/arch.conf"
    "boot/loader/entries/arch-lts.conf"
)

destination_for() {
    local rel="$1"

    case "$rel" in
        etc/*)
            printf '/%s\n' "$rel"
            ;;
        boot/*)
            printf '/%s\n' "$rel"
            ;;
        *)
            echo "HATA: Desteklenmeyen yol: $rel" >&2
            return 1
            ;;
    esac
}

show_files() {
    local title="$1"
    shift

    echo
    echo "==> $title"

    local rel src dest
    for rel in "$@"; do
        src="$HOST_DIR/$rel"
        dest="$(destination_for "$rel")"

        if [[ -f "$src" ]]; then
            printf '    %-55s -> %s\n' "$rel" "$dest"
        else
            printf '    [YOK] %s\n' "$rel"
        fi
    done
}

install_file() {
    local rel="$1"
    local src="$HOST_DIR/$rel"
    local dest

    dest="$(destination_for "$rel")"

    [[ -f "$src" ]] || return 0

    echo "    -> $dest"
    sudo install -Dm644 "$src" "$dest"
}

echo "==> Dotfiles: $DOTFILES_DIR"
echo "==> Host:     $TARGET_HOST"

show_files "Normal sistem dosyaları" "${SAFE_FILES[@]}"
show_files "KRİTİK: depolama / boot dosyaları" "${CRITICAL_FILES[@]}"

if [[ "$APPLY" != true ]]; then
    echo
    echo "DRY-RUN tamamlandı."
    echo
    echo "Hiçbir dosya değiştirilmedi."
    echo "Gerçek uygulama için:"
    echo
    echo "  restore-host --apply"
    exit 0
fi

echo
echo "Bu işlem $TARGET_HOST sistem dosyalarını değiştirecek."
printf "Devam etmek için host adını yaz (%s): " "$TARGET_HOST"
read -r confirmation

if [[ "$confirmation" != "$TARGET_HOST" ]]; then
    echo "İptal edildi."
    exit 1
fi

echo
echo "==> Normal sistem dosyaları kuruluyor..."

for rel in "${SAFE_FILES[@]}"; do
    install_file "$rel"
done

echo
echo "fstab ve systemd-boot girişleri UUID/disk bilgileri içerebilir."
read -r -p "Kritik depolama/boot dosyaları da kopyalansın mı? [y/N] " answer

case "$answer" in
    y|Y|yes|YES)
        echo
        echo "==> Kritik dosyalar kuruluyor..."

        for rel in "${CRITICAL_FILES[@]}"; do
            install_file "$rel"
        done
        ;;
    *)
        echo "==> Kritik dosyalar atlandı."
        ;;
esac

echo
echo "==> systemd yapılandırması yenileniyor..."
sudo systemctl daemon-reload

enable_if_exists() {
    local unit="$1"

    if systemctl cat "$unit" >/dev/null 2>&1; then
        echo "    -> enable $unit"
        sudo systemctl enable "$unit"
    else
        echo "    -> $unit bulunamadı; atlandı."
    fi
}

echo
echo "==> Bilinen servisler bir sonraki açılış için etkinleştiriliyor..."

enable_if_exists greetd.service
enable_if_exists nftables.service
enable_if_exists reflector.timer
enable_if_exists nord-vt-colors.service

echo
echo "==> Host yapılandırması tamamlandı."
echo
echo "Servisler özellikle restart edilmedi."
echo "Değişikliklerin tamamı bir sonraki açılışta uygulanabilir."
