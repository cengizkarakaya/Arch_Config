font=FiraCode Nerd Font Mono 11

background-color=#14161CFA
text-color=#D8DEE9FF

width=360
height=120

outer-margin=10
margin=6
padding=12

border-size=1
border-color=#343945FF
border-radius=8

progress-color=over #A3BE8CFF

icons=1
max-icon-size=48
icon-location=left

markup=1
actions=1

history=1
max-history=20
sort=-time

default-timeout=5000
ignore-timeout=0

anchor=top-right
layer=overlay

format=<b>%s</b>\n%b

on-button-right=dismiss

[urgency=high]
border-color=#BF616AFF
default-timeout=0

# Do Not Disturb
[mode=do-not-disturb]
invisible=1
